# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored; this template is committed.
# Every value below has a working default, so `docker compose up` runs with no
# edits at all — that is the "Demo Mode" path described in the README.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Postgres is the canonical target. To develop without Docker, point this at
# SQLite instead:  DATABASE_URL=sqlite+aiosqlite:///./local.db
# The schema deliberately avoids Postgres-only types to keep that path open.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/engagement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=engagement

# --- LLM provider ---------------------------------------------------------
# LLM_PROVIDER=auto  ->  use Gemini if GEMINI_API_KEY is set, else the
#                        deterministic mock provider (Demo Mode).
# Force either explicitly with: gemini | mock
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude. Either key alone is enough; with both, Gemini wins
# under LLM_PROVIDER=auto because the prompts were tuned against it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048

# --- Security -------------------------------------------------------------
# CHANGE THIS in any non-local deployment. Used to sign JWTs.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# --- Automation -----------------------------------------------------------
# Scheduler runs the engagement rules on this cadence. Set ENABLED=false to
# rely solely on the manual POST /api/v1/automation/run trigger.
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=60
RULE_JOINING_WINDOW_DAYS=7
RULE_SILENCE_THRESHOLD_DAYS=5

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
