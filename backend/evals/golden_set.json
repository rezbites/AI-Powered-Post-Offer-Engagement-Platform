{
  "_about": {
    "purpose": "Labelled scenarios for measuring AI extraction quality.",
    "labels": "expected_risk is a competent recruiter's judgement, not a ground-truth outcome. No historical joined/dropped data exists to calibrate against, so these are informed priors and the accuracy figures should be read as agreement-with-a-reviewer, not correctness.",
    "expected_signals": "Signals a correct extraction must find. Extra signals are counted as false positives; missing ones as false negatives.",
    "note": "Several cases exist specifically to fail the mock provider. That is intentional - an eval that only contains cases the system passes measures nothing."
  },
  "scenarios": [
    {
      "id": "relocation_brief_example",
      "description": "The assignment brief's worked example, verbatim.",
      "expected_risk": "MEDIUM",
      "expected_signals": ["relocation_concern", "positive_intent"],
      "snapshot": {
        "candidate_id": "eval-01",
        "name": "Fariq Kaul",
        "role_title": "Software Engineer II",
        "location": "Hyderabad",
        "status": "engaged",
        "days_to_joining": 12,
        "days_since_interaction": 8,
        "stages_completed": 2,
        "stages_total": 6,
        "stages_overdue": 2,
        "pending_stage": "Documentation",
        "interactions": [
          {"direction": "outbound", "channel": "email", "days_ago": 18, "content": "Welcome aboard! Delighted to have you joining us."},
          {"direction": "inbound", "channel": "email", "days_ago": 17, "content": "Thank you! Really looking forward to getting started."},
          {"direction": "outbound", "channel": "whatsapp", "days_ago": 9, "content": "Checking in - how are the joining formalities coming along?"},
          {"direction": "inbound", "channel": "whatsapp", "days_ago": 8, "content": "I am still figuring out relocation and accommodation."}
        ]
      }
    },
